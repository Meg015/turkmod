[Unit]
Description=Mod Portal WebSocket server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/siteler/web/turkmod.net/public_html
ExecStart=/usr/bin/php scripts/websocket-server.php
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
